{
  "manifest_version": 3,
  "name": "Lightwell Camera Studio",
  "version": "0.4.0",
  "description": "Arrange live browser camera, HTML and drawing layers on a programmable stage.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/lightwell-16.png",
    "32": "icons/lightwell-32.png",
    "48": "icons/lightwell-48.png",
    "128": "icons/lightwell-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lightwell Camera Studio",
    "default_icon": {
      "16": "icons/lightwell-16.png",
      "32": "icons/lightwell-32.png"
    }
  },
  "options_ui": {
    "page": "studio.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "148",
  "message_serialization": "structured_clone"
}
